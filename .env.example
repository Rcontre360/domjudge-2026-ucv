# Admin user created on the DomJudge web UI.
# This account is used by the contest/upload.py script to authenticate against
# the DomJudge API.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Password used by every judgehost container to register with the domserver.
# All judgehost containers in docker-compose.yml share the same password.
JUDGEHOST_PASSWORD=judgehostpw

# Host port for the DomJudge web interface.
DOMSERVER_PORT=8080
